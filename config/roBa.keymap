#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 50

&zip_temp_layer {
    require-prior-idle-ms = <500>;
    excluded-positions = <
        18 // J
        20 // L
        31 // ,
    >;
};

&trackball_listener {
    input-processors = <
        &zip_temp_layer 4 10000
    >;
};

&mkp_input_listener {
    input-processors = <
        &zip_temp_layer 4 250
    >;
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    scroll-layers = <8>;

    arrows {
        layers = <7>;
        bindings =
            <&kp RIGHT_ARROW>,
            <&kp LEFT_ARROW>,
            <&kp UP_ARROW>,
            <&kp DOWN_ARROW>;

        tick = <20>;
        wait-ms = <5>;
        tap-ms = <5>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        excl {
            bindings = <&kp EXCL>;
            key-positions = <31 32>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <7 8>;
        };

        percent {
            bindings = <&kp PERCENT>;
            key-positions = <26 27>;
        };

        // ---- Android用コンボを足すときの雛形（コメントを外して使う） ----
        // layers = <1> と書くと、Androidメインレイヤー(1)のときだけ反応する。
        // layers を書かないコンボ（上の3つ）は今までどおり全レイヤーで反応する。
        //
        // android_example {
        //     bindings = <&kp ESCAPE>;
        //     key-positions = <10 11>;
        //     layers = <1>;
        // };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        win_number: win_number {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 6 &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LGUI &mo 6>;
        };

        zoom_in_wheel: zoom_in_wheel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &msc SCRL_UP>,
                <&macro_release>,
                <&msc SCRL_UP &kp LCTRL>;
        };

        zoom_out_wheel: zoom_out_wheel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &msc SCRL_DOWN>,
                <&macro_release>,
                <&msc SCRL_DOWN &kp LCTRL>;
        };

        // ================= ここから Android用 追加分 =================

        // BT0:Mac BT1:win BT2:iPad BT3:android BT4:win= Windows用
        bt0_mac: bt0_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 0 &to 0>;
        };

        bt1_win: bt1_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 1 &to 0>;
        };

        bt2_ipad: bt2_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 2 &to 0>;
        };

        // BT3 = Android用（BT_SEL 3）。切替と同時にレイヤー1(ANDROID)へ
        bt3_android: bt3_android {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 3 &to 1>;
        };

        bt4_win: bt4_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 4 &to 0>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_UP_DOWN";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <100>;
        };

        td_lang: td_language2_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LANGUAGE_2>, <&kp LANGUAGE_1>;
        };

        // Windows-style shortcuts, enabled only by bindings on Android layers.
        // Keep GUI where Android needs Cmd; suppress it for Ctrl+Space.
        android_space: android_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&lt 5 SPACE>, <&kp LC(SPACE)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        android_d: android_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp D>, <&kp ENTER>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        android_a: android_a {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&mt LCTRL A>, <&kp N>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        // Keep Page Up on NUMBER, but send Cmd+O while Win is held.
        android_number_o: android_number_o {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PAGE_UP>, <&kp O>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        android_up: android_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP_ARROW>, <&kp LC(UP_ARROW)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        android_down: android_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOWN_ARROW>, <&kp LC(DOWN_ARROW)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        android_left: android_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&alt_back>, <&kp LC(LEFT_ARROW)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        android_right: android_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_ARROW>, <&kp LC(RIGHT_ARROW)>;
            mods = <(MOD_LGUI | MOD_RGUI)>;
            keep-mods = <(MOD_LGUI | MOD_RGUI)>;
        };

        // Alt+← を Cmd+Backspace（Androidの「戻る」）に変える。
        // keep-mods を書かないので Alt は外れて、Cmd+Backspace だけが送られる
        alt_back: alt_back {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ARROW>, <&kp LG(BACKSPACE)>;
            mods = <(MOD_LALT | MOD_RALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&mt LEFT_ALT Q    &kp W         &lt 8 E      &kp R     &kp T                                             &kp Y        &kp U  &lt 8 I    &lt 7 O  &mt RIGHT_ALT P
&mt LCTRL A       &kp S         &kp D        &kp F     &kp G        &kp LS(LG(S))      &kp RIGHT_WIN     &kp H        &kp J  &kp K      &kp L    &lt 3 APOS
&mt LEFT_SHIFT Z  &kp X         &kp C        &kp V     &kp B        &lt 2 MINUS        &mt RCTRL ESCAPE  &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_ALT  &win_number  &td_lang  &lt 5 SPACE  &lt 3 TAB          &kp BACKSPACE     &lt 6 ENTER                             &kp DELETE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        ANDROID {
            bindings = <
&mt LEFT_ALT Q    &kp W         &lt 8 E      &kp R     &kp T                                             &kp Y        &kp U  &lt 8 I    &lt 7 O  &mt RIGHT_ALT P
&android_a       &kp S         &android_d        &kp F     &kp G        &kp LS(LG(S))      &kp RIGHT_WIN     &kp H        &kp J  &kp K      &kp L         &lt 3 APOS
&mt LEFT_SHIFT Z  &kp X         &kp C        &kp V     &kp B        &lt 2 MINUS        &mt RCTRL ESCAPE  &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_ALT  &win_number  &td_lang  &android_space  &lt 3 TAB          &kp BACKSPACE     &lt 6 ENTER                             &kp DELETE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        // Keep HALF_SPEED below mouse and scroll modes: the driver checks the highest layer.
        HALF_SPEED {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        M_MOUSE {
            bindings = <
&trans  &kp LC(LS(TAB))   &kp UP    &kp LC(TAB)        &zoom_in_wheel                       &trans  &kp HOME  &trans    &kp PAGE_UP    &kp RIGHT_ALT
&trans  &kp LEFT          &kp DOWN  &kp RIGHT          &mo 2            &trans      &trans  &trans  &mkp MB1  &trans    &mkp MB2       &kp RCTRL
&trans  &kp LS(LG(LEFT))  &trans    &kp LS(LG(RIGHT))  &zoom_out_wheel  &trans      &trans  &trans  &kp END   &mkp MB4  &kp PAGE_DOWN  &kp RIGHT_SHIFT
&trans  &trans            &trans    &trans             &trans           &trans      &trans  &trans                                     &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        A_MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &trans    &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &mkp MB4  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        FUNCTION {
            bindings = <
&kp LEFT_ALT    &kp F7  &kp F8  &kp F9  &kp F12                       &kp AT         &kp TILDE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &mt RIGHT_ALT SEMICOLON
&kp LCTRL       &kp F4  &kp F5  &kp F6  &kp F11  &trans       &trans  &kp HASH       &kp MINUS  &kp LEFT_BRACE        &kp RIGHT_BRACE        &mt RCTRL COLON
&kp LEFT_SHIFT  &kp F1  &kp F2  &kp F3  &kp F10  &kp F13      &trans  &kp AMPERSAND  &kp UNDER  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &mt RIGHT_SHIFT BACKSLASH
&trans          &trans  &trans  &trans  &trans   &trans       &trans  &trans                                                                 &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUMBER {
            bindings = <
&mt LEFT_ALT PLUS  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                                       &trans  &kp HOME        &kp UP_ARROW    &kp PAGE_UP      &kp RIGHT_ALT
&mt LCTRL ASTRK    &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SLASH  &kp LC(LA(KP_NUMBER_0))      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&mt LEFT_SHIFT N0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT    &kp EQUAL                    &trans  &trans  &kp END         &none           &kp PAGE_DOWN    &kp DOLLAR
&trans             &trans        &trans        &trans        &trans     &trans                       &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        ARROW {
            bindings = <
&trans  &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &zoom_in_wheel                       &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &zoom_out_wheel  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans           &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans                  &trans          &trans                   &trans           &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &mo 2   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        // 9: Android + NUMBER. Other keys fall through to the shared layer.
        ANDROID_NUMBER {
            bindings = <
&trans &trans &trans &trans &trans                   &trans &trans &android_up &android_number_o &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &android_left &android_down &android_right &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans
            >;
        };

        // 10: Shared media layer stays above the Android number overlay.
        MEDIA_BT {
            bindings = <
&trans  &trans  &trans  &trans  &kp C_VOLUME_UP                             &bt0_mac  &bt1_win  &bt2_ipad  &bt3_android  &bt4_win
&trans  &trans  &trans  &trans  &kp C_MUTE         &trans      &bootloader  &trans    &trans    &trans    &trans        &trans
&trans  &trans  &trans  &trans  &kp C_VOLUME_DOWN  &trans      &sys_reset   &trans    &trans    &trans    &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans             &trans      &trans       &trans                                      &bt BT_CLR_ALL
            >;
        };

    };
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <5 6>;
            then-layer = <10>;
        };

        android_number {
            if-layers = <1 6>;
            then-layer = <9>;
        };

    };
};
